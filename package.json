{
  "name": "windy",
  "version": "0.2.4",
  "description": "Keyboard-first dual-pane file manager prototype.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:app": "tauri build --no-bundle --ci",
    "test": "node --experimental-strip-types --import ./scripts/register-ts-test-loader.mjs scripts/run-ts-tests.mjs",
    "test:browser": "vite --config tests/workspace.vite.config.ts --open /tests/workspaceSmoke.html",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "bundle:macos:dmg": "bash scripts/build-macos-dmg.sh"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "@xterm/addon-fit": "~0.11.0",
    "@xterm/xterm": "~6.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "~4.0.0",
    "@sveltejs/kit": "~3.0.0",
    "@sveltejs/vite-plugin-svelte": "~7.3.1",
    "@tauri-apps/cli": "~2.11.1",
    "@types/node": "~25.6.0",
    "svelte": "~5.57.1",
    "svelte-check": "~4.7.6",
    "typescript": "~5.6.2",
    "vite": "~8.3.2"
  }
}
